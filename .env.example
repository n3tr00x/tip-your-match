# Copy this file to `.env` and fill in the values.

# --- Database ---
# Local: run `pnpm prisma:dev` and copy the TCP connection strings it prints
# (ports may differ between machines).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Optional: used by `prisma migrate dev`; `prisma dev` exposes it on the next port.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Optional: direct (non-pooled) connection for migrations, e.g. on Vercel/Neon.
# DATABASE_URL_UNPOOLED=

# --- football-data.org ---
# Free API key: https://www.football-data.org/client/register
FOOTBALL_API_BASE_URL="https://api.football-data.org/v4"
FOOTBALL_API_KEY=
FOOTBALL_API_COMPETITION_ID="PL"
# Season start year, e.g. 2026 for the 2026/27 season.
FOOTBALL_API_SEASON="2026"

# --- better-auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
# Optional: auth client base URL; defaults to the current origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OAuth providers ---
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron ---
# Bearer token for /api/cron/sync-fixtures. Generate with: openssl rand -hex 32
CRON_SECRET=
